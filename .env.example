# From your Meta app -> Settings -> Basic
META_APP_SECRET=replace-me

# Any string you invent; paste the same one into the webhook setup form
META_VERIFY_TOKEN=replace-me

# Protects /admin/*. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=replace-me

# 1 = record outbound sends to the DB instead of calling Meta. Flip to 0 when live.
META_DRY_RUN=1

# Instagram Login path. Facebook Login path: https://graph.facebook.com/v25.0
GRAPH_BASE=https://graph.instagram.com/v25.0

DB_PATH=dm_engine.db

# --- optional features ---
# AI replies. Without this, automations with an --ai-brief fall back to canned text.
ANTHROPIC_API_KEY=
# Where captured leads get POSTed (Zapier / Make / n8n / your own endpoint).
LEAD_WEBHOOK_URL=
